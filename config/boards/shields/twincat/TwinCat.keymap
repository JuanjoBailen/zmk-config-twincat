#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define MEDIA 1
#define BLUETOOTH 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <

                &kp C_MUTE  &kp ESC     &kp N1    &kp N2    &kp N3 &kp N4    &kp N5     &kp N6  &kp N7    &kp N8     &kp N9  &kp N0     &kp MINUS &kp EQUAL             &kp BSPC   &kp C_MUTE
                &kp F5      &kp TAB               &kp Q     &kp W  &kp E     &kp R      &kp T   &kp Y     &kp U      &kp I   &kp O      &kp P     &kp LBKT  &kp RBKT               &kp PG_UP
                &kp F8      &kp CAPS              &kp A     &kp S  &kp D     &kp F      &kp G   &kp H     &kp J      &kp K   &kp L      &kp SEMI  &kp SQT   &kp NUHS    &kp ENTER  &kp PG_DN
                &kp F9      &kp LSHIFT  &kp NUBS  &kp Z     &kp X  &kp C     &kp V      &kp B   &kp B     &kp N      &kp M   &kp COMMA  &kp DOT   &kp SLASH &kp RSHIFT  &kp UP     &kp END
                &kp F3      &kp LCTRL   &kp LGUI  &kp LALT  &mo 1            &kp SPACE                    &kp SPACE          &mo 1      &kp RGUI  &kp RCTRL &kp LEFT    &kp DOWN   &kp RIGHT 
            >;
        };

        bt_layer {
            display-name = "Bluetooth";
            bindings = <
                &none       &none        &none   &none           &none  &none  &none  &none   &none     &none       &none  &none      &none       &none               &none    &none
                &bootloader &bt BT_CLR           &studio_unlock  &none  &none  &none  &none   &none     &none       &none  &none      &none       &none     &none              &none
                &none       &none                &none           &none  &none  &none  &none   &none     &none       &none  &none      &none       &none     &none     &none    &none
                &none       &none        &none   &none           &none  &none  &none  &none   &none     &none       &none  &none      &none       &none     &none     &none    &none
                &none       &none        &none   &none           &none         &none                    &none              &none      &none       &none     &none     &none    &none
            >;
        };

        

        

        

       

    };
};